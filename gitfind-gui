    # ---------- estado ----------
    def mode_key(self):
        return MODES[self.mode.get_active()][0]

    def set_busy(self, busy, msg=None):
        self.busy = busy
        self.btn_search.set_sensitive(not busy)
        self.spinner.start() if busy else self.spinner.stop()
        if msg:
            self.status.set_text(msg)

    def on_prev(self, *_):
        if self.page > 1 and not self.busy:
            self.page -= 1
            self.on_search(keep_page=True)

    def on_next(self, *_):
        if not self.busy and self.last_count >= int(self.f_limit.get_value()):
            self.page += 1
            self.on_search(keep_page=True)

    def update_pager(self):
        limit = int(self.f_limit.get_value())
        is_list = self.mode_key() in ("repos", "code")
        self.lbl_page.set_text(f"pág. {self.page}" if is_list else "—")
        self.btn_prev.set_sensitive(is_list and self.page > 1 and not self.busy)
        self.btn_next.set_sensitive(
            is_list and self.last_count >= limit and not self.busy)

    def on_mode_changed(self, _):
        m = self.mode_key()
        is_repo = m == "repos"
        for w in (self.f_topic, self.f_stars):
            w.set_sensitive(is_repo)
        self.f_lang.set_sensitive(m in ("repos", "code"))
        self.c_tags.set_visible(is_repo)
        self.c_stars.set_visible(is_repo)
        self.c_lang.set_visible(is_repo)
        self.c_date.set_visible(is_repo)
        placeholder = {
            "repos": "tema, ex.: análise de dados SAP",
            "code": "trecho de código, ex.: def handle_webhook",
            "topics": "tema para descobrir tópicos, ex.: sap",
        }[m]
        self.entry.set_placeholder_text(placeholder)
        self.f_exact.set_sensitive(m in ("repos", "code"))
        self.update_pager()

    # ---------- busca ----------
    def build_cmd(self):
        q = self.entry.get_text().strip()
        if not q:
            return None
        cmd = [GITFIND, "--porcelain", "-n", str(int(self.f_limit.get_value()))]
        m = self.mode_key()
        if m == "code":
            cmd.append("-c")
        elif m == "topics":
            cmd.append("-T")
        if m in ("repos", "code") and self.f_lang.get_text().strip():
            cmd += ["-l", self.f_lang.get_text().strip()]
        if m == "repos":
            if self.f_topic.get_text().strip():
                cmd += ["-t", self.f_topic.get_text().strip()]
            if self.f_stars.get_text().strip():
                cmd += ["-s", self.f_stars.get_text().strip()]
        if self.f_user.get_text().strip():
            cmd += ["-u", self.f_user.get_text().strip()]
        if self.f_exact.get_active() and m in ("repos", "code"):
            cmd.append("-x")
        if m in ("repos", "code"):
            cmd += ["-p", str(self.page)]
        if self.f_nocache.get_active():
            cmd.append("--no-cache")
        cmd.append(q)
        return cmd

    def on_search(self, *_, keep_page=False):
        if self.busy:
            return
        if not keep_page:
            self.page = 1
        cmd = self.build_cmd()
        if not cmd:
            self.status.set_text("digite algo para buscar")
            return
        self.set_busy(True, "buscando: " + " ".join(shlex.quote(c) for c in cmd[1:]))
        mode = self.mode_key()
        threading.Thread(target=self._search_worker, args=(cmd, mode), daemon=True).start()

    def _search_worker(self, cmd, mode):
        ok, out, err = run(cmd)
        GLib.idle_add(self._search_done, ok, out, err, mode)

    def _search_done(self, ok, out, err, mode):
        self.store.clear()
        self.rows.clear()
        self.preview.get_buffer().set_text("")
        if not ok:
            self.last_count = 0
            self.set_busy(False, "erro: " + (err.strip().splitlines() or ["falhou"])[-1])
            self.update_pager()
            return
        n = 0
        for line in out.splitlines():
            if not line.strip():
                continue
            f = line.split("\t")
            if mode == "repos" and len(f) >= 6:
                repo, stars, lang, date, tags, desc = f[0], f[1], f[2], f[3], f[4], f[5]
                self.store.append([tags, int(stars or 0), repo, lang, date, desc])
                self.rows.append((repo, None))
            elif mode == "code" and len(f) >= 2:
                self.store.append(["", 0, f[0], "", "", f[1]])
                self.rows.append((f[0], f[1]))
            elif mode == "topics":
                self.store.append(["", 0, f[0], "", "", f[1] if len(f) > 1 else ""])
                self.rows.append((f[0], None))
            else:
                continue
            n += 1
        if n:
            self.tree.set_cursor(Gtk.TreePath.new_first(), None, False)
        self.last_count = n
        first = (self.page - 1) * int(self.f_limit.get_value()) + 1
        if n:
            msg = f"{n} resultado(s) — itens {first} a {first + n - 1}"
        else:
            msg = "nenhum resultado nesta página"
        self.set_busy(False, msg)
        self.update_pager()
        return False

    # ---------- preview ----------
    def current(self):
        model, it = self.tree.get_selection().get_selected()
        if not it:
            return None
        idx = model.get_path(it).get_indices()[0]
        return self.rows[idx] if idx < len(self.rows) else None

    def url_for(self, item):
        repo, path = item
        m = self.mode_key()
        if m == "topics":
            return f"https://github.com/topics/{repo}"
        if path:
            return f"https://github.com/{repo}/blob/HEAD/{path}"
        return f"https://github.com/{repo}"

    def on_select(self, _sel):
        item = self.current()
        if not item:
            return
        self.preview_token += 1
        token = self.preview_token
        m = self.mode_key()
        if m == "topics":
            self.render_markdown(
                f"## Tópico: {item[0]}\n\nUse-o como filtro:\n\n"
                f"`gitfind <palavras> -t {item[0]}`\n\n"
                f"Ou na aba **Repositórios**, campo *Tópico*.")
            return
        self.render_plain("carregando…")
        model, it = self.tree.get_selection().get_selected()
        head = ""
        if it and m == "repos":
            head = (f"name:\t{model[it][2]}\n"
                    f"description:\t{model[it][5]}\n--\n")
        threading.Thread(target=self._preview_worker, args=(item, m, token, head),
                         daemon=True).start()

    def _preview_worker(self, item, mode, token, head=""):
        repo, path = item
        if mode == "repos":
            # `gh repo view` passa o README por um formatador printf e destroi
            # todo "%20", "%3A"... A API devolve o markdown intacto.
            ok, out, err = run(
                ["gh", "api", "-H", "Accept: application/vnd.github.raw",
                 f"repos/{repo}/readme"], timeout=30)
            if ok:
                out = head + out
            else:
                ok, out, err = True, head + "\n*(este repositório não tem README)*", ""

        else:
            ok, out, err = run(
                ["gh", "api", "-H", "Accept: application/vnd.github.raw",
                 f"repos/{repo}/contents/{path}"], timeout=30)
            if ok:
                out = self._focus(out, self.entry.get_text().strip())
        GLib.idle_add(self._preview_done, ok, out or err, token, mode)

    @staticmethod
    def _focus(text, needle, ctx=8):
        """Recorta o arquivo em volta da primeira ocorrencia do termo."""
        lines = text.splitlines()
        if needle:
            low = needle.lower()
            for i, l in enumerate(lines):
                if low in l.lower():
                    a, b = max(0, i - ctx), min(len(lines), i + ctx + 1)
                    return "\n".join(f"{j+1:5d} {'>' if j == i else ' '} {lines[j]}"
                                     for j in range(a, b))
        return "\n".join(f"{j+1:5d}   {l}" for j, l in enumerate(lines[:80]))

    def _preview_done(self, ok, text, token, mode="repos"):
        if token != self.preview_token:
            return False       # chegou uma selecao mais nova
        if not ok:
            self.render_plain("(sem preview)")
        elif mode == "repos":
            self.render_markdown(text)
        else:
            self.render_plain(text)
        return False


    # ---------- renderizacao de markdown ----------
    # Cores fixas quebram em um dos dois temas. Detectamos a luminancia da cor
    # de texto do proprio widget: texto claro => tema escuro.
    PAL_LIGHT = dict(code_bg="#eceff4", code_fg="#a03306", block_bg="#f2f4f7",
                     block_fg="#26323f", link="#0b66c3", quote="#5a6673",
                     dim="#6b7683", rule="#c3ccd5", alert="#0b66c3")
    PAL_DARK = dict(code_bg="#343b45", code_fg="#e8a06a", block_bg="#272c33",
                    block_fg="#ccd4dd", link="#72b8f5", quote="#9aa6b3",
                    dim="#8d98a5", rule="#4a525c", alert="#72b8f5")

    def _on_theme_changed(self, *_):
        self._apply_palette()
        item = self.current()
        if item:
            self.on_select(self.tree.get_selection())

    def _palette(self):
        fg = self.preview.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        lum = 0.2126 * fg.red + 0.7152 * fg.green + 0.0722 * fg.blue
        return self.PAL_DARK if lum > 0.5 else self.PAL_LIGHT

    def _apply_palette(self, *_):
        """(Re)pinta as tags conforme o tema atual. Chamado tambem ao troca-lo."""
        p = self._palette()
        b = self.preview.get_buffer().get_tag_table()
        def setp(name, **kw):
            tag = b.lookup(name)
            if tag:
                for k, v in kw.items():
                    tag.set_property(k, v)
        setp("code", background=p["code_bg"], foreground=p["code_fg"])
        setp("codeblock", background=p["block_bg"], foreground=p["block_fg"])
        setp("table", foreground=p["block_fg"])
        setp("link", foreground=p["link"])
        setp("quote", foreground=p["quote"])
        setp("dim", foreground=p["dim"])
        setp("rule", foreground=p["rule"])
        setp("alert", foreground=p["alert"])

    def _init_tags(self, buf):
        """Cria as tags de formatacao uma vez; depois so se aplica."""
        t = buf.create_tag
        t("h1", weight=Pango.Weight.BOLD, scale=1.7,
          pixels_above_lines=16, pixels_below_lines=8)
        t("h2", weight=Pango.Weight.BOLD, scale=1.35,
          pixels_above_lines=14, pixels_below_lines=6)
        t("h3", weight=Pango.Weight.BOLD, scale=1.15,
          pixels_above_lines=12, pixels_below_lines=4)
        t("h4", weight=Pango.Weight.BOLD, pixels_above_lines=10)
        t("bold", weight=Pango.Weight.BOLD)
        t("italic", style=Pango.Style.ITALIC)
        t("bolditalic", weight=Pango.Weight.BOLD, style=Pango.Style.ITALIC)
        t("strike", strikethrough=True)
        t("code", family="monospace", scale=0.92)
        t("codeblock", family="monospace", scale=0.9, left_margin=26,
          pixels_above_lines=0, pixels_below_lines=0)
        t("link", underline=Pango.Underline.SINGLE)
        t("quote", style=Pango.Style.ITALIC, left_margin=26)
        t("alert", weight=Pango.Weight.BOLD)
        t("li", left_margin=26)
        t("li2", left_margin=46)
        t("dim")
        t("rule")
        t("title", weight=Pango.Weight.BOLD, scale=1.5,
          pixels_below_lines=2)
        t("table", family="monospace", scale=0.9)
        self._apply_palette()

    # imagens de badge nao valem espaco no painel
    _BADGE = re.compile(r"(shields\.io|badge|travis-ci|circleci|codecov|"
                        r"appveyor|coveralls|snyk\.io|deploy\.workers)", re.I)

    _REFDEF = re.compile(r"^\s{0,3}\[([^\]]+)\]:\s*<?([^\s>]+)>?\s*(?:\".*\")?\s*$")

    _INLINE = re.compile(r"""
          (?P<rimg>\[!\[(?P<rialt>[^\]]*)\]\[(?P<riref>[^\]]*)\]\]\[(?P<rlref>[^\]]*)\])
        | (?P<rlink>\[(?P<rltext>[^\]]*)\]\[(?P<rref>[^\]]*)\])
        | (?P<limg>\[!\[(?P<lialt>[^\]]*)\]\((?P<liimg>[^)\s]*)[^)]*\)\]
             \((?P<liurl>[^)\s]*)[^)]*\))
        | (?P<img>!\[(?P<ialt>[^\]]*)\]\((?P<iurl>[^)\s]*)[^)]*\))
        | (?P<link>\[(?P<ltext>[^\]]*)\]\((?P<lurl>[^)\s]*)[^)]*\))
        | (?P<code>`[^`\n]+`)
        | (?P<bold>\*\*[^*\n]+\*\*|__[^_\n]+__)
        | (?P<ital>\*[^*\s][^*\n]*\*|(?<![a-zA-Z0-9_])_[^_\s][^_\n]*_)
        | (?P<strike>~~[^~\n]+~~)
    """, re.X)

    _HTML = re.compile(r"<[^>\n]{1,200}>")
    _HTML_OPEN = re.compile(r"<[a-zA-Z/!][^>]*$")     # tag que abre e nao fecha
    _HTML_CLOSE = re.compile(r"^[^<]*>")              # o fecho dela, linhas depois

    def _plainify(self, t):
        """Texto puro de uma celula: sem HTML, sem links, sem asteriscos."""
        t = htmlmod.unescape(self._HTML.sub("", t))
        t = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", t)
        t = re.sub(r"!?\[([^\]]*)\]\[[^\]]*\]", r"\1", t)
        t = re.sub(r"(\*\*|__|~~|`)", "", t)
        return re.sub(r"\s+", " ", t).strip()

    @staticmethod
    def _emit(buf, text, *tags):
        if not text:
            return
        if tags:
            buf.insert_with_tags_by_name(buf.get_end_iter(), text, *tags)
        else:
            buf.insert(buf.get_end_iter(), text)

    def _inline(self, buf, line, *base, depth=0):
        """Escreve uma linha aplicando negrito, italico, codigo e links.

        Recorre: negrito pode conter link, link pode conter codigo, etc.
        """
        line = htmlmod.unescape(self._HTML.sub("", line))
        if depth > 4:                     # guarda contra aninhamento patologico
            self._emit(buf, line, *base)
            return
        pos = 0
        for m in self._INLINE.finditer(line):
            self._emit(buf, line[pos:m.start()], *base)
            pos = m.end()
            if m.group("rimg") is not None:
                img = self._refs.get((m.group("riref") or "").lower(), "")
                url = self._refs.get((m.group("rlref") or "").lower(), "")
                if self._BADGE.search(img) or self._BADGE.search(url):
                    continue
                self._emit(buf, (m.group("rialt") or "").strip() or url,
                           "link", *base)
            elif m.group("rlink") is not None:
                txt = (m.group("rltext") or "").strip()
                ref = (m.group("rref") or "").lower() or txt.lower()
                if self._BADGE.search(self._refs.get(ref, "")):
                    continue
                self._inline(buf, txt, "link", *base, depth=depth + 1)
            elif m.group("limg") is not None:
                img, url = m.group("liimg") or "", m.group("liurl") or ""
                if self._BADGE.search(img) or self._BADGE.search(url):
                    continue                      # badge clicavel: descarta
                alt = (m.group("lialt") or "").strip()
                self._emit(buf, alt or url, "link", *base)
            elif m.group("img") is not None:
                url, alt = m.group("iurl") or "", (m.group("ialt") or "").strip()
                if self._BADGE.search(url):
                    continue                      # badge: descarta
                self._emit(buf, f"🖼 {alt or 'imagem'}", "dim", *base)
            elif m.group("link") is not None:
                txt = self._HTML.sub("", (m.group("ltext") or "")).strip()
                if txt:
                    self._inline(buf, txt, "link", *base, depth=depth + 1)
                else:
                    self._emit(buf, m.group("lurl"), "link", *base)
            elif m.group("code") is not None:
                self._emit(buf, m.group("code").strip("`"), "code", *base)
            elif m.group("bold") is not None:
                self._inline(buf, m.group("bold")[2:-2], "bold", *base,
                             depth=depth + 1)
            elif m.group("ital") is not None:
                self._inline(buf, m.group("ital")[1:-1], "italic", *base,
                             depth=depth + 1)
            elif m.group("strike") is not None:
                self._inline(buf, m.group("strike")[2:-2], "strike", *base,
                             depth=depth + 1)
        self._emit(buf, line[pos:], *base)

    def render_markdown(self, md):
        """Desenha o README no painel: cabecalhos, negrito, codigo, links."""
        buf = self.preview.get_buffer()
        buf.set_text("")
        self.preview.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)

        lines = md.split("\n")

        # definicoes de link por referencia: [ref]: https://... (e some da saida)
        self._refs = {}
        keep = []
        for ln in lines:
            mr = self._REFDEF.match(ln)
            if mr:
                self._refs[mr.group(1).lower()] = mr.group(2)
            else:
                keep.append(ln)
        lines = keep

        # cabecalho do `gh repo view`: name:/description: ate o separador --
        if lines and lines[0].startswith("name:"):
            head, rest = [], lines
            for i, ln in enumerate(lines):
                if ln.strip() == "--":
                    head, rest = lines[:i], lines[i + 1:]
                    break
            for ln in head:
                k, _, v = ln.partition("\t")
                if k.startswith("name:"):
                    self._emit(buf, v + "\n", "title")
                elif v.strip():
                    self._emit(buf, v + "\n", "dim")
            self._emit(buf, "─" * 44 + "\n\n", "rule")
            lines = rest

        para = []

        def flush(extra=()):
            if para:
                self._inline(buf, " ".join(para), *extra)
                self._emit(buf, "\n", *extra)
                para.clear()

        in_code = False
        fence_ch, fence_len = "", 0
        in_list = False
        html_open = False
        prev_blank = True
        for raw in lines:
            raw = raw.rstrip()

            # citacao: remove os ">" logo de cara. Se ficarem, uma cerca de
            # codigo dentro de um blockquote nao e reconhecida como cerca.
            mq = re.match(r"^(\s{0,3}(?:>\s?)+)(.*)$", raw)
            quoted = bool(mq)
            if mq:
                raw = mq.group(2)
            qt = ("quote",) if quoted else ()

            ln = raw.rstrip()
            bare = ln.lstrip()

            # cerca de codigo. Guardamos o marcador porque READMEs aninham
            # ```` por fora de ``` -- fechar em qualquer cerca embaralha tudo.
            fm = re.match(r"(`{3,}|~{3,})", bare)
            if fm:
                mk = fm.group(1)
                if not in_code:
                    flush(qt); in_code, fence_ch, fence_len = True, mk[0], len(mk)
                    continue
                if mk[0] == fence_ch and len(mk) >= fence_len:
                    in_code = False
                    self._emit(buf, "\n")
                    continue
            if in_code:
                self._emit(buf, ln + "\n", "codeblock")
                continue

            # bloco de codigo por indentacao (4 espacos), fora de lista.
            # HTML indentado (ex.: <blockquote> com um tweet) nao e' codigo.
            if (not in_list and re.match(r"(    |\t)\S", raw)
                    and not bare.startswith(("<", "&"))):
                flush(qt)
                self._emit(buf, raw.expandtabs(4)[4:] + "\n", "codeblock")
                continue

            # tag HTML espalhada por varias linhas: engole ate o ">"
            if html_open:
                mc = self._HTML_CLOSE.match(bare)
                if mc:
                    html_open = False
                    ln = bare[mc.end():]
                    if not ln.strip():
                        continue
                else:
                    continue
            elif self._HTML_OPEN.search(bare):
                ln = self._HTML_OPEN.sub("", bare)
                html_open = True
                if not ln.strip():
                    continue

            stripped = ln.strip()

            if not stripped:
                flush(qt)
                if not prev_blank:
                    self._emit(buf, "\n")
                prev_blank = True
                continue
            prev_blank = False
            if not raw[:1].isspace():
                in_list = False          # linha na margem encerra a lista

            # linha horizontal
            if re.fullmatch(r"(-{3,}|\*{3,}|_{3,})", stripped):
                flush(qt)
                self._emit(buf, "\u2500" * 44 + "\n", "rule")
                continue

            # cabecalho
            m = re.match(r"(#{1,6})\s+(.*)", stripped)
            if m:
                flush(qt)
                lvl = min(len(m.group(1)), 4)
                self._inline(buf, m.group(2), f"h{lvl}")
                self._emit(buf, "\n")
                continue

            # alerta do GitHub: > [!NOTE]
            m = re.fullmatch(r"\[!(\w+)\]", stripped)
            if m:
                flush(qt)
                self._emit(buf, m.group(1).capitalize() + "\n", "alert")
                continue

            # tabela markdown
            if stripped.startswith("|") and stripped.endswith("|"):
                flush(qt)
                cells = [c.strip() for c in stripped.strip("|").split("|")]
                if all(re.fullmatch(r":?-{2,}:?", c) for c in cells if c):
                    continue                       # linha separadora
                cells = [self._plainify(c) for c in cells]
                self._emit(buf, "  ".join(f"{c[:22]:<22}" for c in cells).rstrip()
                           + "\n", "table")
                continue

            # lista
            m = re.match(r"^(\s*)([-*+]|\d+[.)])\s+(.*)", raw)
            if m:
                flush(qt)
                depth = len(m.group(1)) // 2
                marker = "\u2022" if not m.group(2)[0].isdigit() else m.group(2)
                tag = "li2" if depth else "li"
                self._emit(buf, f"{marker} ", tag, *qt)
                self._inline(buf, m.group(3), tag, *qt)
                self._emit(buf, "\n", tag, *qt)
                in_list = True
                continue

            # paragrafo comum (linha so de HTML vira nada, nao vira espaco em branco)
            if not self._HTML.sub("", stripped).strip():
                continue
            para.append(stripped)

        flush()

    def render_plain(self, text):
        buf = self.preview.get_buffer()
        buf.set_text("")
        self.preview.set_wrap_mode(Gtk.WrapMode.NONE)
        self._emit(buf, text, "codeblock")

    # ---------- acoes ----------
    def on_row_activated(self, *_):
        self.on_open()

    def on_open(self, *_):
        item = self.current()
        if item:
            Gtk.show_uri_on_window(self, self.url_for(item), Gdk.CURRENT_TIME)

    def on_copy(self, *_):
        item = self.current()
        if not item:
            return
        url = self.url_for(item)
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(url, -1)
        self.status.set_text("copiado: " + url)

    def on_clone(self, *_):
        item = self.current()
        if not item or self.mode_key() == "topics":
            self.status.set_text("selecione um repositório")
            return
        repo = item[0]
        dlg = Gtk.FileChooserDialog(
            title=f"Clonar {repo} em…", parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons("Cancelar", Gtk.ResponseType.CANCEL,
                        "Clonar aqui", Gtk.ResponseType.ACCEPT)
        dlg.set_current_folder(os.path.expanduser("~"))
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            dest = dlg.get_filename()
            dlg.destroy()
            self.set_busy(True, f"clonando {repo} em {dest}…")
            threading.Thread(target=self._clone_worker, args=(repo, dest),
                             daemon=True).start()
        else:
            dlg.destroy()

    def _clone_worker(self, repo, dest):
        target = os.path.join(dest, repo.split("/")[-1])
        ok, out, err = run(["gh", "repo", "clone", repo, target], timeout=600)
        GLib.idle_add(self.set_busy, False,
                      f"clonado em {target}" if ok
                      else "falha ao clonar: " + err.strip().splitlines()[-1][:120])


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        w = Window(self)
        w.show_all()
        w.c_tags.set_visible(True)
        w.present()


if __name__ == "__main__":
    import sys
    if not os.path.exists(GITFIND):
        print("gitfind não encontrado em ~/.local/bin — instale-o primeiro.")
        sys.exit(1)
    sys.exit(App().run(sys.argv))
